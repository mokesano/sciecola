/**
 * Cloudflare Pages / Wrangler config for the Sciecola SPA.
 *
 * Wrangler v4 refuses to auto-detect a project when it lands in an npm
 * workspace root ("The Cloudflare application detection logic has been
 * run in the root of a workspace..."), so we explicitly declare this as
 * a Pages project pointing at the Vite build output.
 *
 * Build output is generated by `npm run build:cloudflare` (which also
 * runs after any `npm run build` — see scripts/postbuild-cloudflare.mjs
 * wired via the "postbuild" hook) into ./public/app, alongside the
 * SPA-fallback `_redirects` and cache-policy `_headers` files.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sciecola",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "./public/app"
}
