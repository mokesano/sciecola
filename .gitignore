# Sicola .gitignore

# Database
/database/sciecola.db
/database/*.db
/database/*.sqlite

# Runtime / Storage
/storage/
/api/cache/
/logs/*.log
!/logs/.gitkeep

# Dependencies
/vendor/
/node_modules/
node_modules/
.pnpm/
.yarn/
yarn.lock
package-lock.json

# Vite/Rollup
dist/
build/
.vite/
*.map

# Environment
.env.local
.env*.local
*.env
.env
.env.*
!.env.example

# Testing
coverage/
.nyc_output/
*.test.*
*.spec.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
/dist/
/public/build/

# Editor / OS
.DS_Store
.DS_Store?
desktop.ini
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# PHP
*.phar
/composer.lock
/package-lock.json

# Optional: Jika pakai TypeScript
*.tsbuildinfo

# Debug files
/public/debug.php