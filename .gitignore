# Sciecola Platform .gitignore

# Database
/database/sciecola.db
/database/*.db
/database/*.sqlite

# Runtime / Storage
/storage/
/api/cache/
/logs/*.log
!/logs/.gitkeep

# Dependencies
/vendor/
/node_modules/
node_modules/
.pnpm/
.yarn/
frontend-src/node_modules/

# PHP
*.phar

# Vite/Rollup
dist/
build/
.vite/
*.map

# Frontend build output (Vite writes here; regenerated on every build)
/public/app/

# Environment
.env.local
.env*.local
*.env
.env
.env.*
!.env.example

# Testing
coverage/
.nyc_output/
*.test.*
*.spec.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
/dist/
/public/build/
/public/assets/sicola-ui/

# Editor / OS
.DS_Store
.DS_Store?
desktop.ini
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Optional: Jika pakai TypeScript
*.tsbuildinfo

# Debug files
/public/debug.php

# Deployment artifacts
.github/workflows/webdeploy.yml
