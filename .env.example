# Wizdam Ecosystem — Environment Configuration
# ============================================================
# Gunakan nilai DB_* yang SAMA di semua repository:
#   - sdgs-mapper
#   - SDGs-analytics
#   - wizdam-apis
#   - wizdam-sikola
#
# Copy ke .env dan isi nilainya.
# JANGAN commit .env ke version control.
# ============================================================

# ================================================================
# APPLICATION
# ================================================================
APP_ENV=development
APP_URL=http://localhost:5173
SITE_URL=http://localhost/workspace

# ================================================================
# DATABASE — TERPUSAT (sama untuk semua repository)
# ================================================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wizdam_ecosystem
DB_USER=wizdam_app
DB_PASS=
DB_CHARSET=utf8mb4

# ================================================================
# WIZDAM / SANGIA API
# ================================================================
WIZDAM_API_BASE=https://api.sangia.org
WIZDAM_API_KEY=

# ================================================================
# MAIL / SMTP
# Set MAIL_DRIVER to:
#   log   – write to /tmp/sciecola_mail.log (local dev)
#   smtp  – use SMTP server (requires SMTP_* values)
#   mail  – PHP native mail()
# ================================================================
MAIL_DRIVER=log
MAIL_FROM=noreply@sciecola.ai
MAIL_FROM_NAME=Sciecola

# SMTP only used when MAIL_DRIVER=smtp AND SMTP_USER is non-empty
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# ================================================================
# CACHE
# ================================================================
CACHE_TTL=86400

# ================================================================
# EXTERNAL APIS (read-only, public endpoints)
# ================================================================
ORCID_API_URL=https://pub.orcid.org/v3.0
CROSSREF_API_URL=https://api.crossref.org/works
OPENALEX_API_URL=https://api.openalex.org/works

