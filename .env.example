# Sciecola Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All values can also be set as real server environment variables.

# ================================================================
# APPLICATION
# ================================================================
APP_ENV=development
APP_URL=http://localhost:5173
SITE_URL=http://localhost/workspace

# ================================================================
# DATABASE
# ================================================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sicola_db
DB_USER=sicola
DB_PASS=

# ================================================================
# WIZDAM / SANGIA API
# ================================================================
WIZDAM_API_BASE=https://api.sangia.org
WIZDAM_API_KEY=

# ================================================================
# MAIL / SMTP
# Set MAIL_DRIVER to:
#   log   – write to /tmp/sciecola_mail.log (local dev)
#   smtp  – use SMTP server (requires SMTP_* values)
#   mail  – PHP native mail()
# ================================================================
MAIL_DRIVER=log
MAIL_FROM=noreply@sciecola.ai
MAIL_FROM_NAME=Sciecola

# SMTP only used when MAIL_DRIVER=smtp AND SMTP_USER is non-empty
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# ================================================================
# CACHE
# ================================================================
CACHE_TTL=86400

# ================================================================
# EXTERNAL APIS (read-only, public endpoints)
# ================================================================
ORCID_API_URL=https://pub.orcid.org/v3.0
CROSSREF_API_URL=https://api.crossref.org/works
OPENALEX_API_URL=https://api.openalex.org/works
