# ═══════════════════════════════════════════════════════════════════════
# Sangia Ecosystem — Environment Configuration
# sciecola | sangia-apis | sangia-scieco | sangia-analytics | sdg-mono
#
# Nilai DB_* dan WIZDAM_SHARED_SECRET harus IDENTIK di semua repo.
# Copy ke .env dan isi nilainya.
# JANGAN commit .env ke version control.
# ═══════════════════════════════════════════════════════════════════════

# =======================================================================
# ── APPLICATION ────────────────────────────────────────────────────────
# =======================================================================
APP_ENV=development
APP_URL=https://www.sangia.org
FRONTEND_URL=https://www.sangia.org

# =======================================================================
# ── DATABASE (SHARED — identik di semua apps) ──────────────────────────
# =======================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sangia_ecosystem
DB_USERNAME=sangia_sciecola
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# =======================================================================
# ── SHARED SECRET (generate sekali: openssl rand -hex 32) ──────────────
# =======================================================================
# Nilai ini HARUS sama persis di .env semua repo ekosistem Sangia
SANGIA_SHARED_SECRET=same_value_as_in_all_other_apps

# =======================================================================
# ── SANGIA-APIS ENDPOINT (Backend / Server-Side) ───────────────────────
# =======================================================================
# URL dan API Key ini dibaca OLEH FILE PHP (misal: api/proxy.php).
# Nilainya AMAN karena diproses di server dan TIDAK PERNAH dikirim 
# ke browser pengguna.
SANGIA_API_URL=https://api.sangia.org
SANGIA_API_KEY=wz_generated_key_here

# =======================================================================
# ── FRONTEND (React) ───────────────────────────────────────────────────
# =======================================================================
# PENTING: Vite HANYA membaca variabel yang diawali dengan 'VITE_'.
# Nilai ini akan disuntikkan (inject) ke dalam bundle JavaScript saat 
# Anda menjalankan 'npm run build'.
#
# PANDUAN PENGISIAN:
# 1. Development Lokal: Biarkan kosong (VITE_API_BASE_URL=). 
#    Frontend akan otomatis menggunakan proxy Vite ke localhost:8000.
# 2. Production / Deployment: NILAI INI HARUS SAMA PERSIS dengan 
#    SANGIA_API_URL di atas. (Contoh: https://api.sangia.org)
#    Jika berbeda, frontend tidak akan bisa menemukan endpoint API Anda.
VITE_API_BASE_URL=https://api.sangia.org

# =======================================================================
# ── ORCID OAuth2 ───────────────────────────────────────────────────────
# =======================================================================
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://www.sangia.org/auth/orcid-callback
ORCID_SANDBOX=true

# =======================================================================
# ── EXTERNAL APIS ──────────────────────────────────────────────────────
# =======================================================================
SCOPUS_API_KEY=
OPENALEX_MAILTO=api@sangia.org
CROSSREF_MAILTO=api@sangia.org

# =======================================================================
# ── MAIL / SMTP ────────────────────────────────────────────────────────
# =======================================================================
# MAIL_DRIVER: log | smtp | mail
MAIL_DRIVER=log
MAIL_FROM=noreply@sangia.org
MAIL_FROM_NAME=Wizdam
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# =======================================================================
# ── CACHE ──────────────────────────────────────────────────────────────
# =======================================================================
CACHE_TTL=86400

# =======================================================================
# ── ADMIN TOOLS ────────────────────────────────────────────────────────
# =======================================================================
# Token untuk akses tools/cache-migrator.php via header X-Admin-Token
ADMIN_TOOL_TOKEN=
