# ═══════════════════════════════════════════════════════════════════════
# Sangia Ecosystem — Environment Configuration
# sciecola | sangia-apis | sangia-scieco | sangia-analytics | sdg-mono
#
# Nilai DB_* dan WIZDAM_SHARED_SECRET harus IDENTIK di semua repo.
# Copy ke .env dan isi nilainya.
# JANGAN commit .env ke version control.
# ═══════════════════════════════════════════════════════════════════════

# =======================================================================
# ── APPLICATION ────────────────────────────────────────────────────────
# =======================================================================
APP_ENV=development
APP_URL=https://www.sangia.org
FRONTEND_URL=https://www.sangia.org

# =======================================================================
# ── DATABASE (SHARED — identik di semua apps) ──────────────────────────
# =======================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sangia_ecosystem
DB_USERNAME=sangia_sciecola
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# =======================================================================
# ── SHARED SECRET (generate sekali: openssl rand -hex 32) ──────────────
# =======================================================================
# Nilai ini HARUS sama persis di .env semua repo ekosistem Sangia
SANGIA_SHARED_SECRET=same_value_as_in_all_other_apps

# =======================================================================
# ── SANGIA-APIS ENDPOINT (Backend / Server-Side) ───────────────────────
# =======================================================================
# URL dan API Key ini dibaca OLEH FILE PHP (misal: api/proxy.php).
# Nilainya AMAN karena diproses di server dan TIDAK PERNAH dikirim 
# ke browser pengguna.
SANGIA_API_URL=https://api.sangia.org
SANGIA_API_KEY=wz_generated_key_here

# =======================================================================
# ── FRONTEND (React) ───────────────────────────────────────────────────
# =======================================================================
# PENTING: Vite HANYA membaca variabel yang diawali dengan 'VITE_'.
# Nilai ini akan disuntikkan (inject) ke dalam bundle JavaScript saat 
# Anda menjalankan 'npm run build'.
#
# PANDUAN PENGISIAN:
# 1. Development Lokal: Biarkan kosong (VITE_API_BASE_URL=). 
#    Frontend akan otomatis menggunakan proxy Vite ke localhost:8000.
# 2. Production / Deployment: NILAI INI HARUS SAMA PERSIS dengan 
#    SANGIA_API_URL di atas. (Contoh: https://api.sangia.org)
#    Jika berbeda, frontend tidak akan bisa menemukan endpoint API Anda.
# REACT_API_BASE_URL=https://api.sangia.org
# REACT_APP_API_KEY=wz_generated_key_here

# =======================================================================
# ── ORCID OAuth2 ───────────────────────────────────────────────────────
# =======================================================================
# Mengaktifkan tombol "Masuk/Hubungkan ORCID". Daftarkan redirect URI ini di ORCID:
#   {APP_URL}/api/auth.php?action=oauth_callback&provider=orcid
# ORCID_SANDBOX=true memakai sandbox.orcid.org (uji coba); false untuk produksi.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_SANDBOX=false

# =======================================================================
# ── GOOGLE SIGN-IN (opsional) ──────────────────────────────────────────
# =======================================================================
# Redirect URI di Google Cloud Console:
#   {APP_URL}/api/auth.php?action=oauth_callback&provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =======================================================================
# ── AKUN & KEAMANAN LOGIN ──────────────────────────────────────────────
# =======================================================================
# Email (dipisah koma) yang otomatis berperan admin setelah emailnya
# diverifikasi. Cara termudah menyiapkan admin pertama.
ADMIN_EMAILS=
# Wajib verifikasi email sebelum bisa masuk (disarankan true). Butuh MAIL_DRIVER
# yang benar-benar mengirim email (smtp atau mail).
REQUIRE_EMAIL_VERIFICATION=true
# Cloudflare Turnstile untuk form masuk/daftar/lupa sandi. Kosong = tanpa captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =======================================================================
# ── EXTERNAL APIS ──────────────────────────────────────────────────────
# =======================================================================
SCOPUS_API_KEY=
OPENALEX_MAILTO=api@sangia.org
CROSSREF_MAILTO=api@sangia.org

# =======================================================================
# ── MAIL / SMTP ────────────────────────────────────────────────────────
# =======================================================================
# MAIL_DRIVER: log | smtp | mail
#   log  = hanya ditulis ke logs/mail.log (email TIDAK terkirim; untuk lokal)
#   smtp = akun email cPanel, mis. SMTP_HOST=mail.domainanda.com,
#          SMTP_PORT=465 + SMTP_SECURE=ssl, atau SMTP_PORT=587 + SMTP_SECURE=tls
#   mail = fungsi mail() PHP di server
# APP_URL wajib diisi alamat situs live agar tautan verifikasi/reset benar.
MAIL_DRIVER=log
MAIL_FROM=noreply@sangia.org
MAIL_FROM_NAME=Wizdam
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# =======================================================================
# ── CACHE ──────────────────────────────────────────────────────────────
# =======================================================================
CACHE_TTL=86400

# =======================================================================
# ── ADMIN TOOLS ────────────────────────────────────────────────────────
# =======================================================================
# Token admin cadangan (header X-Admin-Token) untuk endpoint admin bila belum
# ada akun admin. Akun yang login dengan peran admin tidak memerlukannya.
# Buat dengan: php -r "echo bin2hex(random_bytes(24));"
ADMIN_TOOL_TOKEN=
