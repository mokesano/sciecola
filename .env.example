# ═══════════════════════════════════════════════════════════════
# Sangia Ecosystem — Environment Configuration
# sciecola | sangia-apis | sangia-scieco | sdgs-analytics | sdg-mono
#
# Nilai DB_* dan WIZDAM_SHARED_SECRET harus IDENTIK di semua repo.
# Copy ke .env dan isi nilainya.
# JANGAN commit .env ke version control.
# ═══════════════════════════════════════════════════════════════

# ── APPLICATION ─────────────────────────────────────────────────
APP_ENV=development
APP_URL=https://www.sangia.org
FRONTEND_URL=https://www.sangia.org

# ── DATABASE (SHARED — identik di semua apps) ────────────────────
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sangia_ecosystem
DB_USERNAME=sangia_sciecola
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# ── SHARED SECRET (generate sekali: openssl rand -hex 32) ────────
# Nilai ini HARUS sama persis di .env semua repo ekosistem Sangia
SANGIA_SHARED_SECRET=same_value_as_in_all_other_apps

# ── SANGIA-APIS ENDPOINT ─────────────────────────────────────────
SANGIA_API_URL=https://api.sangia.org
SANGIA_API_KEY=wz_generated_key_here

# ── ORCID OAuth2 ─────────────────────────────────────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://www.sangia.org/auth/orcid-callback
ORCID_SANDBOX=true

# ── EXTERNAL APIS ────────────────────────────────────────────────
SCOPUS_API_KEY=
OPENALEX_MAILTO=api@sangia.org
CROSSREF_MAILTO=api@sangia.org

# ── FRONTEND (React) ─────────────────────────────────────────────
REACT_APP_API_URL=https://api.sangia.org
REACT_APP_API_KEY=wz_generated_key_here

# ── MAIL / SMTP ──────────────────────────────────────────────────
# MAIL_DRIVER: log | smtp | mail
MAIL_DRIVER=log
MAIL_FROM=noreply@sangia.org
MAIL_FROM_NAME=Wizdam
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# ── CACHE ────────────────────────────────────────────────────────
CACHE_TTL=86400

# ── ADMIN TOOLS ──────────────────────────────────────────────────
# Token untuk akses tools/cache-migrator.php via header X-Admin-Token
ADMIN_TOOL_TOKEN=
