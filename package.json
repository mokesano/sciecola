{
  "name": "sdgs-mapper-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root scripts for Sicola PHP and React Hybrid",
  "workspaces": [
    "frontend-src"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend-src",
    "dev:frontend": "npm run dev -w frontend-src",
    "build": "npm run build -w frontend-src",
    "build:frontend": "npm run build -w frontend-src",
    "preview": "npm run preview -w frontend-src",
    "install-ui": "npm install -w frontend-src"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "esbuild": "^0.25.0",
    "vite": "6.4.2",
    "react-router-dom": "6.30.3",
    "i18next": "23.16.8",
    "tailwindcss": "3.4.19",
    "@vitest/ui": "2.1.9",
    "jsdom": "25.0.1",
    "vitest": "2.1.9"
  }
}
